#!/usr/bin/env bash
# pre-push — the checks that cost seconds and have twice been skipped anyway.
#
# On 2026-09-01 two pushes went out with a ruff error in them (an unused import,
# then an unnecessary dict comprehension). Both were caught by CI's lint job in
# under ten seconds, which is exactly the point: the information was available
# locally for free and the push happened without asking for it.
#
# NOT a test SUITE — that stays CI's job on both platforms, and a pre-push suite
# would be the very habit the full-suite gate exists to stop. But the four
# STRUCTURAL guards run in 564ms together, and on 2026-09-02 the code-health
# ratchet failed CI four separate times in one session. Each was ~10 minutes of
# CI to learn something that was free here. CI runs these same four as its own
# fast "smoke" job precisely because they are cheap and catch a class nothing
# else does; the only question was why they were not also run before the push.
#
# Enable with:  git config core.hooksPath .githooks
# Bypass with:  git push --no-verify   (and be able to say why)
set -u

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 0

# _main_repo / resolve_py (GATE-7): a branch lacking this file must not kill
# the hook, so guard the source rather than assume it exists.
[ -f "$repo_root/scripts/repo_python.sh" ] && . "$repo_root/scripts/repo_python.sh"
PY=""
if command -v resolve_py >/dev/null 2>&1; then
    PY="$(resolve_py "$repo_root" 2>/dev/null || true)"
fi
[ -n "$PY" ] || PY="$(command -v python3 || true)"
[ -n "$PY" ] || exit 0

# Per-checkout, not the shared /tmp path: two worktrees pushing at once used
# to clobber each other's guard log. A linked worktree's git-dir is its own
# .git/worktrees/<name>/, so this is unique per checkout without being unique
# per run.
LOG="$(git rev-parse --git-dir)/prepush-guards.log"

if "$PY" -m ruff --version >/dev/null 2>&1; then
    if ! "$PY" -m ruff check metatv/ tests/ scripts/ 2>&1; then
        cat >&2 <<'MSG'

PUSH BLOCKED: ruff found something.

CI's lint job reports this in about ten seconds, so pushing first only spends a
round trip to learn what was already knowable here. Most are auto-fixable:

    venv/bin/python -m ruff check --fix metatv/ tests/ scripts/

Genuinely need to push anyway:  git push --no-verify
MSG
        exit 1
    fi
fi

# ── the structural guards ──────────────────────────────────────────────────
#
# Skipped file-by-file when absent: these arrive on different branches (the
# F821 ratchet was written on one), and a hook that dies on a branch missing a
# file is a hook someone disables.
GUARDS=""
for t in tests/test_code_health_ratchet.py \
         tests/test_no_new_undefined_names.py \
         tests/test_mainwindow_launch_smoke.py \
         tests/test_config_isolation.py; do
    [ -f "$t" ] && GUARDS="$GUARDS $t"
done

if [ -n "$GUARDS" ] && [ -x scripts/pytest_verdict.sh ]; then
    # Through the verdict script, so this decides on the exit code and takes the
    # same lock — never a bare pytest whose summary then gets grepped.
    if ! QT_QPA_PLATFORM=offscreen scripts/pytest_verdict.sh $GUARDS >"$LOG" 2>&1; then
        cat >&2 <<MSG

PUSH BLOCKED: a structural guard failed.

These four run in about half a second and catch what a lint pass cannot — a file
grown past its code-health baseline, a new undefined name, a window that no
longer launches, a test writing to the real user config.

    tail -40 $LOG

The ratchet is the usual one. If the growth is deliberate and reviewed:

    venv/bin/python scripts/rebaseline_code_health.py

Genuinely need to push anyway:  git push --no-verify
MSG
        exit 1
    fi
fi

# Shell scripts get parsed too — a syntax error in a gate is a gate that does
# not run, and these are the files least likely to be exercised before a push.
for f in scripts/*.sh .githooks/*; do
    [ -f "$f" ] || continue
    if ! bash -n "$f" 2>/dev/null; then
        echo "PUSH BLOCKED: $f is not valid bash." >&2
        exit 1
    fi
done

exit 0
