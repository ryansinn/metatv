#!/usr/bin/env bash
# pre-commit — the one thing that is cheap here and expensive to undo.
#
# Sibling of pre-push, same reasoning: a rule that costs nothing to check and
# has been broken anyway belongs in a hook, not in another sentence of prose.
#
# Enable with:  git config core.hooksPath .githooks
# Bypass with:  git commit --no-verify   (and be able to say why)
set -u

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 0

# 1. No Co-Authored-By trailer — moved to .githooks/commit-msg (2026-09-05):
# git invokes pre-commit with no arguments, so the message-file check that sat
# here never ran. commit-msg is the hook that receives the message file.

# 2. Not on a branch in the owner's own checkout.
#
# ./run.sh builds from ~/Projects/metatv and the owner UX-tests from it, so it
# always rests on the release tree. Branch work belongs in a temp worktree
# (git worktree add .claude/worktrees/<name> -b <branch> origin/main).
#
# Scoped to the PRIMARY worktree only: a commit inside .claude/worktrees/ is
# exactly what this is asking for, and `git rev-parse --git-dir` says which is
# which (a linked worktree's git dir lives under .git/worktrees/).
git_dir="$(git rev-parse --git-dir)"
case "$git_dir" in
    *".git/worktrees/"*) ;;                      # a linked worktree — fine
    *)
        branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
        if [ -n "$branch" ] && [ "$branch" != "main" ] && [ "$branch" != "HEAD" ]; then
            cat >&2 <<MSG

COMMIT BLOCKED: committing to '$branch' in the owner's own checkout.

This checkout is what ./run.sh builds and what the owner UX-tests from, so it
stays on the release tree. Do branch work in a worktree:

    git worktree add .claude/worktrees/<name> -b <branch> origin/main

Genuinely meant to commit here:  git commit --no-verify
MSG
            exit 1
        fi
        ;;
esac
